# CONFIGURAÇÕES DO SERVIDOR
PORT=3000
NODE_ENV=development

# SEGURANÇA E AUTENTICAÇÃO
JWT_SECRET=substitua_por_uma_chave_secreta_forte
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASS=substitua_por_uma_senha_forte

# BANCO DE DADOS (Local SQLite - Preparado para PostgreSQL / Supabase)
DB_CLIENT=sqlite
DB_PATH=./database/fanatics.sqlite
# DATABASE_URL=postgresql://usuario:senha@host:5432/fanatics_db

# DADOS DA LOJA
STORE_NAME=Fanatics Imports
STORE_INSTAGRAM=@Fanatics.imports_ofc
DEVELOPER_CREDIT=Desenvolvido por Maycon Silva

# INTEGRAÇÃO WHATSAPP BUSINESS CLOUD API
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DESTINATION_NUMBER=5521999999999

# INTEGRAÇÃO MERCADO PAGO (SANDBOX / PRODUÇÃO)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=http://localhost:3000